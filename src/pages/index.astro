---
import PhotoStrip from "@/components/PhotoStrip.astro";
import SocialList from "@/components/SocialList.astro";
import PageLayout from "@/layouts/Base.astro";

const experience = [
	{
		role: "Modeling & Optimization Scientist",
		org: "Deep Origin",
		where: "Cell Sims team · ARPA-H CATALYST · PREDICTS consortium",
		when: "2026 – now",
		points: [
			"Built a framework combining mechanistic simulations and machine learning, enabling patient-level toxicity models to train across multiple simulation engines.",
			"Made previously non-differentiable scientific models trainable and accelerated model training by approximately 15× through gradient methods, precomputation and surrogates.",
			"Developed virtual-cohort and uncertainty methods for patient-level modelling from aggregate clinical-trial summaries when individual patient records are unavailable.",
			"Applied bifurcation analysis to large biological models to identify stability boundaries and treatment-response transitions.",
		],
	},
	{
		role: "PhD Researcher, Process Systems Engineering",
		org: "Imperial College London",
		where: "Sargent Centre · CASE studentship with AstraZeneca · applied to pharmacokinetics and protein crystallisation",
		when: "2022 – now",
		points: [
			"Developed mechanistic ODE/PDE simulators, hybrid mechanistic-ML and pure ML models of dynamic systems from sparse, noisy time series.",
			"Uncertainty quantification and identifiability methods for pharmacokinetic and process models: profile likelihood and Bayesian inference (MCMC, variational inference, ABC).",
			"Methods and open-source implementations for fast global sensitivity analysis and model-based design of experiments.",
			"Closed-loop in-vitro / in-silico work: I was in the lab running the experiments, built the models on that data, and fed the analysis back into experimental and process design.",
		],
	},
	{
		role: "Data Scientist Intern",
		org: "Quaisr",
		where: "London",
		when: "2026",
		points: ["Agentic LLM workflows for regulated pharma process development."],
	},
	{
		role: "Consultant Data Scientist",
		org: "Haleon",
		where: "",
		when: "2025",
		points: [
			"ML soft-sensors reading product quality in real time to within 10% of lab reference, enough to retire up to half of offline QA.",
		],
	},
];

const education = [
	{ degree: "PhD, Chemical Engineering", org: "Imperial College London", when: "2022 – now" },
	{ degree: "MEng, Chemical Engineering, 1st Class Honours", org: "Imperial College London", when: "2018 – 2022" },
];

const publications = [
	{
		title: "Amortised Global Sensitivity Analysis of Pharmacokinetic Models for Simulated Clinical Trials",
		authors: "Pessina D.; Abbiati R. A.; Papathanasiou M. M.",
		venue: "arXiv preprint",
		year: "2026",
		url: "https://arxiv.org/abs/2610.14719",
	},
	{
		title: "Transfer Learning of Data-driven Crystallisation Processes via Constrained Neural Ordinary Differential Equations",
		authors: "Pessina D.; Tian T.; Watson O.; Heng J. Y. Y.; Papathanasiou M. M.",
		venue: "Digital Chemical Engineering",
		year: "2026",
		badge: "Editors' Choice",
		url: "https://www.sciencedirect.com/science/article/pii/S2772508126000050",
	},
	{
		title: "An in silico / in vitro approach for uncertainty-aware hybrid models for template-induced protein crystallisation systems",
		authors: "Pessina D.; Calderon De Anda J.; Heffernan C.; Heng J. Y. Y.; Papathanasiou M. M.",
		venue: "Systems & Control Transactions",
		year: "2026",
		url: "https://doi.org/10.69997/sct.103037",
	},
	{
		title: "Biomolecular Crystallisation Through Soft Templates and Seeding",
		authors: "Heng J.; Verma V.; Mitchell H.; Pessina D.",
		venue: "Advances in Biochemical Engineering / Biotechnology",
		year: "2026",
		url: "https://doi.org/10.1007/10_2025_310",
	},
	{
		title: "Model-based approach to template-induced macromolecule crystallisation",
		authors: "Pessina D.; Calderon De Anda J.; Heffernan C.; Tian T.; Watson O.; Heng J. Y. Y.; Papathanasiou M. M.",
		venue: "Systems & Control Transactions",
		year: "2025",
		url: "https://doi.org/10.69997/sct.131246",
	},
	{
		title: "Machine learning-enhanced Sensitivity Analysis for Complex Pharmaceutical Systems",
		authors: "Pessina D.; Abbiati R. A.; Manca D.; Papathanasiou M. M.",
		venue: "Systems & Control Transactions",
		year: "2025",
		url: "https://doi.org/10.69997/sct.133428",
	},
	{
		title: "Integrated In Vitro / In Silico Uncertainty Quantification Method for Protein Crystallization Models",
		authors: "Pessina D.; Calderon De Anda J.; Heffernan C.; Heng J. Y. Y.; Papathanasiou M. M.",
		venue: "Industrial & Engineering Chemistry Research",
		year: "2025",
		url: "https://doi.org/10.1021/acs.iecr.4c04517",
	},
	{
		title: "Mammalian cell growth characterisation by a non-invasive plate reader assay",
		authors: "Grob A. et al. (incl. Pessina D.)",
		venue: "Nature Communications",
		year: "2024",
		url: "https://doi.org/10.1038/s41467-023-44396-4",
	},
];

const pubYears = [...new Set(publications.map((p) => p.year))];
---

<PageLayout meta={{ title: "Home" }}>
	<section class="flex flex-col gap-6 sm:flex-row sm:items-start sm:gap-10">
		<img
			alt="Daniele Pessina"
			class="h-40 w-32 shrink-0 rounded-sm object-cover"
			height="160"
			src="/profile.jpeg"
			width="128"
		/>
		<div class="min-w-0">
			<h1 class="title mb-1 text-3xl">Daniele Pessina</h1>
			<p class="mb-1">
				Modeling &amp; Optimization Scientist <span class="text-accent">· Deep Origin</span>
			</p>
			<p class="text-muted mb-4 text-xs">Scientific machine learning · mechanistic modelling · uncertainty</p>
			<p class="mb-5 max-w-prose">
				I build scientific machine learning tools for complex biological systems. At Deep Origin, I connect
				mechanistic simulations with trainable models to study patient-level toxicity. My PhD at Imperial
				focuses on uncertainty-aware modelling and experimental design.
			</p>
			<SocialList />
			<p class="mt-5 text-sm">
				<span class="text-accent me-2 rounded-sm border border-accent px-1.5 py-px text-xs font-semibold">New</span>
				<a class="cactus-link" href="https://arxiv.org/abs/2610.14719" rel="noreferrer" target="_blank">
					Amortised global sensitivity analysis of PK models for simulated clinical trials
				</a>
				<span class="text-muted"> · preprint, Oct 2026</span>
			</p>
		</div>
	</section>

	<section class="mt-14" id="now">
		<h2 class="section-title"><span class="section-num">01</span>Current work</h2>
		<div class="card max-w-3xl border-l-4 border-l-accent">
			<h3 class="font-semibold">Virtual patients &amp; in-silico clinical trials</h3>
			<p class="text-muted mb-3 text-xs">Cell Sims team · ARPA-H CATALYST program · PREDICTS consortium · Deep Origin</p>
			<p class="max-w-prose">
				I’m building tools that connect different kinds of biological simulators with machine learning. The
				aim is to train patient-level toxicity models, examine how uncertain their predictions are, and make
				use of clinical evidence even when only aggregate trial results are available.
			</p>
		</div>
	</section>

	<section class="mt-14" id="experience">
		<h2 class="section-title"><span class="section-num">02</span>Experience</h2>
		<ul class="divide-edge divide-y" role="list">
			{
				experience.map((job) => (
					<li class="grid gap-1 py-5 first:pt-0 sm:grid-cols-[8rem_1fr] sm:gap-x-6">
						<span class="text-muted text-xs sm:pt-1">{job.when}</span>
						<div>
							<h3 class="font-semibold">
								{job.role} <span class="text-accent">· {job.org}</span>
							</h3>
							{job.where && <p class="text-muted mb-2 text-xs">{job.where}</p>}
							<ul class="list-disc space-y-1 ps-4 marker:text-muted" role="list">
								{job.points.map((pt) => (
									<li>{pt}</li>
								))}
							</ul>
						</div>
					</li>
				))
			}
		</ul>
	</section>

	<section class="mt-14" id="education">
		<h2 class="section-title"><span class="section-num">03</span>Education</h2>
		<ul class="space-y-3" role="list">
			{
				education.map((e) => (
					<li class="grid gap-1 sm:grid-cols-[8rem_1fr] sm:gap-x-6">
						<span class="text-muted text-xs sm:pt-0.5">{e.when}</span>
						<div>
							<span class="font-semibold">{e.degree}</span>
							<span class="text-muted"> · {e.org}</span>
						</div>
					</li>
				))
			}
		</ul>
		<p class="mt-5 max-w-prose sm:ms-[calc(8rem+1.5rem)]">
			Thesis: a hybrid in-silico / in-vitro approach to the design and optimisation of large-molecule
			crystallisation, supervised by{" "}
			<a class="cactus-link" href="https://www.papathanlab.com/">Maria Papathanasiou</a> and{" "}
			<a class="cactus-link" href="https://profiles.imperial.ac.uk/jerry.heng/">Jerry Heng</a> at the{" "}
			<a class="cactus-link" href="https://www.imperial.ac.uk/process-systems-engineering/">Sargent Centre</a>.
		</p>
	</section>

	<section class="mt-14" id="open-source">
		<h2 class="section-title"><span class="section-num">04</span>Open source</h2>
		<div class="grid gap-6 md:grid-cols-3">
			<div class="border-t-2 border-accent pt-3">
				<a class="cactus-link font-semibold" href="https://danielepessina.github.io/jaxgsa/">jaxgsa</a>
				<p class="mt-1 text-sm">
					JAX library for global sensitivity analysis of large dynamic models (Sobol, RS-HDMR, multi-output),
					hundreds of times faster than SALib on multi-output workloads.
				</p>
				<p class="text-muted mt-2 text-xs">
					<a class="cactus-link" href="https://danielepessina.github.io/jaxgsa/workbench/">WebAssembly demo</a> ·{" "}
					<a class="cactus-link" href="https://arxiv.org/abs/2610.14719">Paper</a>
				</p>
			</div>
			<div class="border-t-2 border-accent pt-3">
				<a class="cactus-link font-semibold" href="https://github.com/DanielePessina/jax-hybridmodels">
					jaxhybridmodels
				</a>
				<p class="mt-1 text-sm">
					JAX/Equinox library for combining user-written ODE dynamics with trainable predictors, supporting
					bounded physical quantities and regular or irregular time-series experiments.
				</p>
				<p class="text-muted mt-2 text-xs">
					<a class="cactus-link" href="https://danielepessina.github.io/jax-hybridmodels/">Documentation</a>
				</p>
			</div>
			<div class="border-t-2 border-accent pt-3">
				<a class="cactus-link font-semibold" href="https://github.com/DanielePessina/CriSTool.jl">CriSTool.jl</a>
				<p class="mt-1 text-sm">
					Julia package for simulating batch crystallisation, fitting kinetic parameters, and propagating
					parameter uncertainty through population-balance models.
				</p>
			</div>
		</div>
	</section>

	<section class="mt-14" id="publications">
		<h2 class="section-title"><span class="section-num">05</span>Selected publications</h2>
		<div class="divide-edge divide-y">
			{
				pubYears.map((year) => (
					<div class="grid gap-1 py-4 first:pt-0 sm:grid-cols-[8rem_1fr] sm:gap-x-6">
						<span class="text-accent text-sm font-semibold">{year}</span>
						<ul class="space-y-4" role="list">
							{publications
								.filter((p) => p.year === year)
								.map((p) => (
									<li>
										<a class="cactus-link font-semibold" href={p.url} rel="noreferrer" target="_blank">
											{p.title}
										</a>
										<p class="text-muted mt-0.5 text-xs">
											{p.authors} · <i>{p.venue}</i>
											{p.badge && (
												<span class="ms-2 inline-block whitespace-nowrap rounded-sm border border-accent px-1.5 py-px text-accent">{p.badge}</span>
											)}
										</p>
									</li>
								))}
						</ul>
					</div>
				))
			}
		</div>
	</section>

	<section class="mt-14" id="photos">
		<h2 class="section-title"><span class="section-num">06</span>I also take photos</h2>
		<PhotoStrip />
	</section>

	<section class="mt-14" id="contact">
		<h2 class="section-title"><span class="section-num">07</span>Contact</h2>
		<p class="mb-4 max-w-prose">
			Based in London. Happiest talking about differentiable simulation, hybrid modelling and making
			scientific code trainable.
		</p>
		<SocialList />
	</section>
</PageLayout>
